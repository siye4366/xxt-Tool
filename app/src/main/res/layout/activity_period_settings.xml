<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tt_bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <LinearLayout style="@style/TtTopBar">
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="返回"
            android:padding="5dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_back"
            android:tint="@color/tt_ink" />

        <TextView
            style="@style/TtTitle"
            android:layout_marginStart="6dp"
            android:text="节次与时间" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/btnSave"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:gravity="center"
            android:paddingLeft="12dp"
            android:paddingRight="4dp"
            android:text="保存"
            android:textColor="@color/tt_accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="18dp"
            android:paddingTop="4dp"
            android:paddingRight="18dp"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="可逐节改时间，也可增删节次或按“每节时长 + 课间”批量生成；改完保存即可。"
                android:textColor="@color/tt_muted"
                android:textSize="10.5sp"
                android:lineSpacingExtra="3dp" />

            <LinearLayout
                android:id="@+id/periodContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/btnAddPeriod"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="＋ 添加一节"
                android:textColor="@color/tt_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRemovePeriod"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="－ 减少一节"
                android:textColor="@color/tt_danger"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnGenerate"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="按规则批量生成"
                android:textColor="@color/tt_ink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btnReset"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_pill"
                android:gravity="center"
                android:text="恢复默认 13 节"
                android:textColor="@color/tt_ink"
                android:textSize="12sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
