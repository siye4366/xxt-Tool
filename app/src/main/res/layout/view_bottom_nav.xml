<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="62dp"
    android:background="@color/tt_bg"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/navHomework"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navHomeworkIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:contentDescription="作业"
            android:scaleType="centerInside"
            android:src="@drawable/ic_homework"
            android:tint="@color/tt_muted2" />

        <TextView
            android:id="@+id/navHomeworkLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="作业"
            android:textColor="@color/tt_muted2"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navTimetable"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navTimetableIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:contentDescription="课表"
            android:scaleType="centerInside"
            android:src="@drawable/ic_calendar"
            android:tint="@color/tt_muted2" />

        <TextView
            android:id="@+id/navTimetableLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="课表"
            android:textColor="@color/tt_muted2"
            android:textSize="9sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navMe"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/navMeIcon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:background="@null"
            android:contentDescription="个人"
            android:scaleType="centerInside"
            android:src="@drawable/ic_person"
            android:tint="@color/tt_muted2" />

        <TextView
            android:id="@+id/navMeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="个人"
            android:textColor="@color/tt_muted2"
            android:textSize="9sp" />
    </LinearLayout>
</LinearLayout>
